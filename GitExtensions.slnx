<Solution>
  <!--
    Solución primaria cross-platform (net10.0): es la que valida el CI en
    Windows y Linux. Contiene únicamente los ensamblados neutrales de
    plataforma y sus tests, de modo que puede abrirse y compilarse en
    Linux/macOS (Rider, VS Code, CLI).

    La solución WinForms completa (GitExtensions.WinForms.slnx) se conserva
    como material de referencia para el portado: incluye la app WinForms
    (GitExtensions, GitUI), los interops Windows-only (GitExtUtils.WinForms,
    ResourceManager, BugReporter), los externals (ConEmu, ICSharpCode.TextEditor,
    NetSpell, Git.hub), los plugins y el instalador WiX. No la compila ni la
    testea el CI.
  -->
  <Folder Name="/src/">
    <Project Path="src/app/GitExtensions.Extensibility/GitExtensions.Extensibility.csproj" />
    <Project Path="src/app/GitExtUtils/GitExtUtils.csproj" />
    <Project Path="src/app/GitCommands/GitCommands.csproj" />
    <Project Path="src/plugins/GitUIPluginInterfaces/GitUIPluginInterfaces.csproj" />
    <Project Path="src/app/GitExtensions.Avalonia/GitExtensions.Avalonia.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/CommonTestUtils/CommonTestUtils.csproj" />
    <Project Path="tests/app/UnitTests/GitCommands.Tests/GitCommands.Tests.csproj" />
  </Folder>
</Solution>
