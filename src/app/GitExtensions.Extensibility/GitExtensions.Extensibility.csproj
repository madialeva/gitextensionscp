<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <TargetFramework>net10.0</TargetFramework>

    <!-- Guardrail (change 0.2, clean-extensibility-winforms): this assembly is the public,
         UI-technology-neutral extensibility contract. It must never reference WinForms/GDI+.
         Overrides the repo-wide UseWindowsForms=true from Directory.Build.props; any WinForms
         type reintroduced in this project will fail to compile. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdysTech.CredentialManager" />
    <PackageReference Include="StrongOf" />
  </ItemGroup>

</Project>
