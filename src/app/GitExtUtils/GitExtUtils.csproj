<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <TargetFramework>net10.0</TargetFramework>

    <!-- Guardrail (change 0.3, extract-ui-interops): this assembly is a dependency of the
         GitCommands core and must stay free of UI technology. Win32 interops, WinForms
         control extensions and GDI+ theming live in GitExtUtils.WinForms instead.
         Overrides the repo-wide UseWindowsForms=true from Directory.Build.props; any WinForms
         type reintroduced in this project will fail to compile. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdysTech.CredentialManager" />
    <PackageReference Include="Ben.Demystifier" />
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitExtensions.Extensibility\GitExtensions.Extensibility.csproj" />
  </ItemGroup>

</Project>
