<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Avalonia.Services.ExceptionDialog"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <TextBox Grid.Row="0" x:Name="ExceptionText" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code,Consolas,monospace" />
        <Button Grid.Row="1" x:Name="OkButton" HorizontalAlignment="Right"
                Margin="0,12,0,0" Width="80" Click="OnOkClick" />
    </Grid>
</Window>
