<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Avalonia.Services.ErrorDialog"
        Width="450" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <TextBlock Grid.Row="0" x:Name="MessageText"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Row="1" x:Name="OkButton" HorizontalAlignment="Right"
                Margin="0,12,0,0" Width="80" Click="OnOkClick" />
    </Grid>
</Window>
