<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override global settings from Directory.Build.props:
         this is an Avalonia (cross-platform) project, not WinForms. -->
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <OutputType>WinExe</OutputType>

    <!-- Avalonia-specific: stop building when XAML has errors -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- On non-Windows use the portable RID for the apphost. Some distro-packaged
         SDKs (e.g. Oracle Linux) bake in a non-portable RID (ol.9-x64) for which
         there is no Microsoft.NETCore.App.Host package on NuGet. -->
    <DefaultAppHostRuntimeIdentifier Condition="'$(OS)' != 'Windows_NT'">$(NETCoreSdkPortableRuntimeIdentifier)</DefaultAppHostRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitExtUtils\GitExtUtils.csproj" />
    <ProjectReference Include="..\GitCommands\GitCommands.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\GitUI\Translation\*.xlf"
                      Exclude="..\GitUI\Translation\*.Plugins.xlf"
                      Link="Localization\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
